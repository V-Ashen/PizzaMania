<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent" android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="8dp" android:background="#AAFFFFFF">
        <TextView android:id="@+id/txtStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold"/>
        <TextView android:id="@+id/txtEta" android:layout_width="match_parent"
            android:layout_marginTop="30dp" android:layout_height="wrap_content"/>
    </LinearLayout>
</FrameLayout>
