<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    android:padding="12dp"
    android:backgroundTint="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Pizza Image -->
        <ImageView
            android:id="@+id/imgPizza"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:scaleType="centerCrop"
            android:src="@drawable/pizza_placeholder"
            android:background="@drawable/rounded_background" />

        <!-- Pizza Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/txtName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Margherita Pizza"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/txtPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LKR 1200"
                android:textSize="14sp"
                android:textColor="@color/grey_800"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/txtLineTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total: LKR 1200"
                android:textSize="13sp"
                android:textColor="@color/grey_600"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Quantity Selector -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/quantity_bg"
            android:padding="4dp"
            android:layout_marginStart="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMinus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="−"
                android:textSize="18sp"
                app:cornerRadius="8dp"
                app:backgroundTint="@color/black"/>

            <TextView
                android:id="@+id/txtQty"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="1"
                android:textSize="16sp"
                android:textColor="@color/black"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="+"
                android:textSize="18sp"
                app:cornerRadius="8dp"
                app:backgroundTint="@color/orange_500"/>
        </LinearLayout>

        <!-- Remove Button -->
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
