<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent" android:padding="10dp">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cartRecycler" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="30dp"/>
    <TextView
        android:id="@+id/textTotalCost" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Total: 0 LKR" android:textColor="@color/black"
        android:textStyle="bold" android:textSize="18sp" android:padding="8dp"/>
    <EditText
        android:id="@+id/editAddress" android:layout_width="match_parent"  android:textColorHint="@color/Dark_Gray"
        android:textColor="@color/black" android:layout_height="wrap_content" android:hint="Delivery Address" />
    <Button
        android:id="@+id/btnConfirmOrder" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Confirm Order"/>
</LinearLayout>
